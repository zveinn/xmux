#!/bin/bash
# Fail if a release binary requires instruction-set extensions that a generic
# build of this architecture must not. Run this on the binary that is about
# to be published.
#
# amd64 rejects AVX-512 (zmm registers and opmask registers). SSE2 and the
# AVX2 paths that crates such as memchr select at runtime are fine; AVX-512
# is not part of a portable amd64 baseline, and it is what SIGILL'd on
# Meteor Lake.
#
# arm64 rejects SVE and SME that the compiler emitted for the host CPU.
# NEON is mandatory in AArch64 and is not checked. SVE inside a
# runtime-dispatched copy (Highway's N_SVE namespaces, simdutf's sve
# implementations) is allowed: those functions run only after a CPU check,
# the same way memchr's AVX2 paths do on amd64. The binary must still have
# its symbol table; strip it after this check.

set -euo pipefail

arch=${1:?usage: check-generic-isa <amd64|arm64> <binary>}
bin=${2:?usage: check-generic-isa <amd64|arm64> <binary>}

if [[ ! -f "$bin" ]]; then
  echo "check-generic-isa: no such file: $bin" >&2
  exit 1
fi

# A pipe into grep -m would SIGPIPE the producer once grep has its 20 lines,
# and pipefail would report that instead of a match. Search a file instead.
dis=$(mktemp)
trap 'rm -f "$dis"' EXIT
objdump -d --no-show-raw-insn "$bin" > "$dis"

# Exit 2 is a grep error and must fail the check. Treating it as "no match"
# would let a bad pattern pass.
reject() {
  local pattern=$1
  local message=$2
  local matches status=0
  matches=$(grep -E -m 20 -n -- "$pattern" "$dis") || status=$?
  if [[ "$status" -eq 0 ]]; then
    printf '%s\n' "$matches" >&2
    echo "error: $bin $message" >&2
    exit 1
  fi
  if [[ "$status" -gt 1 ]]; then
    echo "check-generic-isa: grep failed (status $status) for pattern $pattern" >&2
    exit "$status"
  fi
}

case "$arch" in
  amd64)
    # AT&T objdump: AVX-512 uses %zmm and the opmask registers %k0-%k7.
    # %ymm is intentionally allowed; memchr and similar crates ship AVX2
    # paths and only take them after a runtime CPU check.
    reject '%zmm[0-9]|%k[0-7]([^0-9A-Za-z_]|$)' \
      "contains AVX-512 instructions; the amd64 release build is not generic"
    ;;
  arm64)
    # Operands only, so addresses and labels do not count. SVE uses z0-z31,
    # SME uses za, predicates are p0-p15. NEON uses v registers and is allowed.
    #
    # A symbol is a dispatched copy when its name says so (N_SVE, simdutf::sve,
    # and the same for SME). Anything else is code the baseline compile was
    # not allowed to emit.
    status=0
    awk '
      BEGIN { sym = "<no symbol>" }
      /^[[:xdigit:]]+ <[^>]+>:$/ {
        sym = $2
        gsub(/[<>:]/, "", sym)
        next
      }
      /[[:space:]]z[0-9]{1,2}([.,]|$)|[[:space:]]za([.,]|$)|[[:space:]]p[0-9]{1,2}([.,]|$)/ {
        if (sym ~ /[Ss][Vv][Ee]|[Ss][Mm][Ee]/) {
          allowed++
          next
        }
        bad++
        if (bad <= 20) {
          printf "%s\n%s\n", sym, $0 > "/dev/stderr"
        }
      }
      END {
        if (bad > 0) exit 1
        printf "arm64: %d SVE/SME instructions in runtime-dispatched functions\n", allowed + 0
      }
    ' "$dis" || status=$?
    if [[ "$status" -eq 1 ]]; then
      echo "error: $bin contains SVE or SME instructions outside runtime-dispatched SIMD copies; the arm64 release build is not generic" >&2
      exit 1
    fi
    if [[ "$status" -ne 0 ]]; then
      echo "check-generic-isa: scan failed (status $status)" >&2
      exit "$status"
    fi
    ;;
  *)
    echo "check-generic-isa: unknown arch '$arch' (expected amd64 or arm64)" >&2
    exit 1
    ;;
esac

echo "generic ISA check passed ($arch)"
